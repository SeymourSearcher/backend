.env
.env.*
!.env.example
.git
.gitignore
# Anchored patterns only match the repo root, so these need the ** prefix --
# without it, host-built .pyc files get baked into the image.
**/__pycache__/
**/*.py[cod]
.venv/
venv/
**/.pytest_cache/
.ruff_cache/
# Cargo's build tree is GB-scale and host-specific; the wheel is built in its
# own stage (see Dockerfile).
**/target/
# Regenerated in the image; host copies would only bloat the build context.
app/static/*.npy
